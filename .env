# Server Configuration
PORT=3000

# Instructions:
# 1. Replace 'your-email@gmail.com' with your actual Gmail address
# 2. Replace 'your-app-password' with your Gmail App Password (not regular password)
# 3. To get Gmail App Password:
#    - Go to Google Account settings
#    - Enable 2-Factor Authentication
#    - Go to Security > App passwords
#    - Generate app password for "Mail"
#    - Use that 16-character password here

# Example:
# EMAIL_USER=sarvnoor19@gmail.com
# EMAIL_PASS=abcd efgh ijkl mnop
# RECIPIENT_EMAIL=sarvnoor19@gmail.com